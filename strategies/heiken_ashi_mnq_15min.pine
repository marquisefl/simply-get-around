//@version=5
strategy(
     title              = "Heiken Ashi MNQ 15-Min Strategy",
     shorttitle         = "HA-MNQ-15",
     overlay            = true,
     initial_capital    = 10000,
     default_qty_type   = strategy.fixed,
     default_qty_value  = 1,
     commission_type    = strategy.commission.cash_per_contract,
     commission_value   = 0.62,   // ~$0.62/side for MNQ at most brokers
     slippage           = 2,
     calc_on_order_fills = false,
     process_orders_on_close = false)

// ─── INPUT GROUPS ─────────────────────────────────────────────────────────────
var string GRP_HA   = "█ Heiken Ashi"
var string GRP_FILT = "█ Filters"
var string GRP_RISK = "█ Risk Management"
var string GRP_TIME = "█ Session Filter"

// ── Heiken Ashi ──────────────────────────────────────────────────────────────
ha_consecutive  = input.int  (2,     "Consecutive HA Candles Required",      minval=1, maxval=5,   group=GRP_HA,
     tooltip="Minimum number of same-color HA candles before signaling an entry.")
wick_filter_pct = input.float(15.0,  "Max Counter-Wick % of Body",           minval=0, maxval=100, group=GRP_HA,
     tooltip="For a LONG, the lower wick must be ≤ this % of the body (vice versa for SHORT). Set to 100 to disable.")

// ── Filters ──────────────────────────────────────────────────────────────────
use_ema         = input.bool (true,  "EMA Trend Filter",                     group=GRP_FILT)
ema_len         = input.int  (20,    "  EMA Length",          minval=5,       group=GRP_FILT)
use_vwap        = input.bool (true,  "VWAP Trend Filter",                    group=GRP_FILT,
     tooltip="Long only above VWAP, Short only below VWAP.")
use_rsi         = input.bool (true,  "RSI Filter",                           group=GRP_FILT)
rsi_len         = input.int  (14,    "  RSI Length",                         group=GRP_FILT)
rsi_long_min    = input.int  (45,    "  RSI Long Min",        minval=0, maxval=100, group=GRP_FILT)
rsi_long_max    = input.int  (70,    "  RSI Long Max",        minval=0, maxval=100, group=GRP_FILT)
rsi_short_min   = input.int  (30,    "  RSI Short Min",       minval=0, maxval=100, group=GRP_FILT)
rsi_short_max   = input.int  (55,    "  RSI Short Max",       minval=0, maxval=100, group=GRP_FILT)

// ── Risk Management ──────────────────────────────────────────────────────────
sl_pts          = input.float(100.0, "Stop Loss (Points)",    minval=10,      group=GRP_RISK,
     tooltip="MNQ: 100 pts = $200 risk per contract.")
tp1_pts         = input.float(100.0, "Take Profit 1 (Points)", minval=10,     group=GRP_RISK)
use_tp2         = input.bool (false, "Enable 2:1 Scale-Out",                  group=GRP_RISK,
     tooltip="Exit 50% at TP1 and the remainder at TP2.")
tp2_pts         = input.float(200.0, "Take Profit 2 (Points)", minval=10,     group=GRP_RISK)
tp1_pct         = input.float(50.0,  "  TP1 Exit % of Position", minval=1, maxval=99, group=GRP_RISK)

// ── Session Filter ───────────────────────────────────────────────────────────
use_session     = input.bool (true,  "NY Session Only (9:30–16:00 ET)",       group=GRP_TIME)
kill_zone_only  = input.bool (false, "Kill Zones Only (9:30–11:00, 13:30–15:00 ET)", group=GRP_TIME,
     tooltip="Restricts entries to the highest-probability time windows.")

// ─── HEIKEN ASHI CALCULATIONS ─────────────────────────────────────────────────
ha_c = (open + high + low + close) / 4
ha_o = float(na)
ha_o := na(ha_o[1]) ? (open + close) / 2 : (nz(ha_o[1]) + nz(ha_c[1])) / 2
ha_h = math.max(high, math.max(ha_o, ha_c))
ha_l = math.min(low,  math.min(ha_o, ha_c))

is_bull = ha_c > ha_o
is_bear = ha_c < ha_o

body         = math.abs(ha_c - ha_o)
upper_wick   = ha_h - math.max(ha_o, ha_c)
lower_wick   = math.min(ha_o, ha_c) - ha_l

// Strong candle: counter-wick is small relative to body
strong_bull = is_bull and (body == 0 or (lower_wick / body * 100) <= wick_filter_pct)
strong_bear = is_bear and (body == 0 or (upper_wick / body * 100) <= wick_filter_pct)

// Count consecutive same-color HA candles
f_count_streak(bull_mode) =>
    count = 0
    for i = 0 to ha_consecutive - 1
        if bull_mode
            if is_bull[i]
                count += 1
        else
            if is_bear[i]
                count += 1
    count

bull_streak = f_count_streak(true)
bear_streak = f_count_streak(false)

ha_long_signal  = bull_streak >= ha_consecutive and strong_bull
ha_short_signal = bear_streak >= ha_consecutive and strong_bear

// ─── INDICATORS ───────────────────────────────────────────────────────────────
ema_line = ta.ema(close, ema_len)
[_vwap, _, _] = ta.vwap(hlc3, false, 1)
rsi_val  = ta.rsi(close, rsi_len)

// ─── SESSION LOGIC ────────────────────────────────────────────────────────────
// CME Globex — chart timezone should be set to "America/New_York" in TradingView
in_ny_session    = not na(time("15", "0930-1600", "America/New_York"))
in_kill_zone     = not na(time("15", "0930-1100", "America/New_York")) or
                   not na(time("15", "1330-1500", "America/New_York"))

session_ok = not use_session     ? true  :
             kill_zone_only      ? in_kill_zone :
             in_ny_session

// ─── ENTRY CONDITIONS ─────────────────────────────────────────────────────────
flat = strategy.position_size == 0

long_ok = ha_long_signal
     and (not use_ema  or close > ema_line)
     and (not use_vwap or close > _vwap)
     and (not use_rsi  or (rsi_val >= rsi_long_min and rsi_val <= rsi_long_max))
     and session_ok
     and flat

short_ok = ha_short_signal
     and (not use_ema  or close < ema_line)
     and (not use_vwap or close < _vwap)
     and (not use_rsi  or (rsi_val >= rsi_short_min and rsi_val <= rsi_short_max))
     and session_ok
     and flat

// ─── STRATEGY EXECUTION ───────────────────────────────────────────────────────
if long_ok
    strategy.entry("Long", strategy.long, comment="HA Long")
    if use_tp2
        strategy.exit("L-TP1", "Long", qty_percent=tp1_pct,  profit=tp1_pts, loss=sl_pts, comment="TP1")
        strategy.exit("L-TP2", "Long", qty_percent=100,       profit=tp2_pts, loss=sl_pts, comment="TP2")
    else
        strategy.exit("L-TP1", "Long", qty_percent=100,       profit=tp1_pts, loss=sl_pts, comment="TP1")

if short_ok
    strategy.entry("Short", strategy.short, comment="HA Short")
    if use_tp2
        strategy.exit("S-TP1", "Short", qty_percent=tp1_pct, profit=tp1_pts, loss=sl_pts, comment="TP1")
        strategy.exit("S-TP2", "Short", qty_percent=100,      profit=tp2_pts, loss=sl_pts, comment="TP2")
    else
        strategy.exit("S-TP1", "Short", qty_percent=100,      profit=tp1_pts, loss=sl_pts, comment="TP1")

// ─── VISUALS ──────────────────────────────────────────────────────────────────
// Heiken Ashi candles overlaid on real price chart
plotcandle(ha_o, ha_h, ha_l, ha_c,
     title      = "HA Candles",
     color      = is_bull ? color.new(#26a69a, 10) : color.new(#ef5350, 10),
     wickcolor  = is_bull ? #26a69a : #ef5350,
     bordercolor= is_bull ? #26a69a : #ef5350)

// EMA
plot(use_ema ? ema_line : na, "EMA", color=color.orange, linewidth=2)

// VWAP
plot(use_vwap ? _vwap : na, "VWAP", color=color.new(color.purple, 0), linewidth=1, style=plot.style_circles)

// Signal arrows
plotshape(long_ok,  "Long Signal",  shape.triangleup,   location.belowbar,
     color=color.new(color.lime, 0),    size=size.small, text="LONG",  textcolor=color.lime)
plotshape(short_ok, "Short Signal", shape.triangledown, location.abovebar,
     color=color.new(color.red, 0),     size=size.small, text="SHORT", textcolor=color.red)

// Session background
bgcolor(use_session and in_kill_zone ? color.new(color.blue, 92) : na,
     title="Kill Zone Highlight")

// ─── DASHBOARD TABLE ──────────────────────────────────────────────────────────
var table dash = table.new(position.bottom_right, 2, 9,
     bgcolor=color.new(color.black, 75),
     border_color=color.new(color.gray, 50),
     border_width=1, frame_color=color.gray, frame_width=1)

if barstate.islast
    // Header
    table.cell(dash, 0, 0, "HA MNQ 15-Min",   text_color=color.white, text_size=size.small,
         bgcolor=color.new(color.navy, 40))
    table.cell(dash, 1, 0, "Values",           text_color=color.white, text_size=size.small,
         bgcolor=color.new(color.navy, 40))
    // SL
    table.cell(dash, 0, 1, "Stop Loss",        text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 1, str.tostring(sl_pts, "#") + " pts  ($" + str.tostring(sl_pts * 2, "#") + ")",
         text_color=color.red, text_size=size.tiny)
    // TP1
    table.cell(dash, 0, 2, "TP1 (1:1)",        text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 2, str.tostring(tp1_pts, "#") + " pts  ($" + str.tostring(tp1_pts * 2, "#") + ")",
         text_color=color.lime, text_size=size.tiny)
    // TP2
    table.cell(dash, 0, 3, "TP2 (2:1)",        text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 3, use_tp2 ? str.tostring(tp2_pts, "#") + " pts  ($" + str.tostring(tp2_pts * 2, "#") + ")" : "OFF",
         text_color=use_tp2 ? color.lime : color.gray, text_size=size.tiny)
    // RSI
    table.cell(dash, 0, 4, "RSI",              text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 4, str.tostring(rsi_val, "#.0"),
         text_color=rsi_val > 70 ? color.red : rsi_val < 30 ? color.lime : color.white,
         text_size=size.tiny)
    // Position
    table.cell(dash, 0, 5, "Position",         text_color=color.silver, text_size=size.tiny)
    pos_txt   = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT"
    pos_color = strategy.position_size > 0 ? color.lime : strategy.position_size < 0 ? color.red : color.gray
    table.cell(dash, 1, 5, pos_txt, text_color=pos_color, text_size=size.tiny)
    // Win Rate
    total_trades = strategy.closedtrades
    wins         = strategy.wintrades
    wr_txt = total_trades > 0 ? str.tostring(wins / total_trades * 100, "#.0") + "%" : "—"
    table.cell(dash, 0, 6, "Win Rate",         text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 6, wr_txt,             text_color=color.white,  text_size=size.tiny)
    // Net PnL
    table.cell(dash, 0, 7, "Net P&L",          text_color=color.silver, text_size=size.tiny)
    pnl_color = strategy.netprofit >= 0 ? color.lime : color.red
    table.cell(dash, 1, 7, "$" + str.tostring(strategy.netprofit, "#.00"),
         text_color=pnl_color, text_size=size.tiny)
    // Session
    table.cell(dash, 0, 8, "Session",          text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 8, session_ok ? "ACTIVE" : "CLOSED",
         text_color=session_ok ? color.lime : color.gray, text_size=size.tiny)
